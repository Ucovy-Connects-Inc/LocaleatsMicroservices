{
  "ReverseProxy": {
    "Routes": {
      "cuisinesRoute": {
        "ClusterId": "cuisinesCluster",
        "Match": { "Path": "/api/cuisines/{**catch-all}" }
      },
      "restaurantsRoute": {
        "ClusterId": "restaurantsCluster",
        "Match": { "Path": "/api/restaurants/{**catch-all}" }
      },
      "reviewsRoute": {
        "ClusterId": "reviewsCluster",
        "Match": { "Path": "/api/reviews/{**catch-all}" }
      }
    },
    "Clusters": {
      "cuisinesCluster": {
        "Destinations": { "c1": { "Address": "http://cuisineapi:80/" } }
      },
      "restaurantsCluster": {
        "Destinations": { "r1": { "Address": "http://restaurantservice:80/" } }
      },
      "reviewsCluster": {
        "Destinations": { "rv1": { "Address": "http://reviewservice:80/" } }
      }
    }
  }
}
